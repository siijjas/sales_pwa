# Copy to .env (the file is ignored by git) and keep it private.
WA_API_KEY=change-me-to-a-long-random-string
WA_PORT=3010
WA_HOST=127.0.0.1
# WA_AUTH_DIR=auth
# Pair with a code instead of scanning a QR: the WhatsApp number, digits only, with country code.
# WA_PHONE=9715xxxxxxx
# WA_LOG_LEVEL=info
# WA_PRINT_QR=1   # also print the pairing QR / code on stdout (off by default; stdout is the journal under systemd)
# WA_BAILEYS_LOG_LEVEL=warn
# WA_NODE=/home/frappe/.nvm/versions/node/v20.19.6/bin/node   # for the systemd unit, when node is not on its PATH
